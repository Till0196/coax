;
; Development INF for binding the DigiBest ISDB2056 family (ISDB2056,
; ISDB2056N, PLEX PX-M1UR) to the in-box WinUSB driver. Production
; distribution requires a signed catalog.

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49F0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
CatalogFile = isdb2056-winusb.cat
DriverVer   = 09/05/2026,1.0.0.0

[Manufacturer]
%ManufacturerName% = DeviceList,NTamd64,NTarm64

[DeviceList.NTamd64]
%ISDB2056Name%  = WinUSBInstall, USB\VID_0511&PID_004B
%ISDB2056NName% = WinUSBInstall, USB\VID_0511&PID_084B
%M1URName%      = WinUSBInstall, USB\VID_0511&PID_0854

[DeviceList.NTarm64]
%ISDB2056Name%  = WinUSBInstall, USB\VID_0511&PID_004B
%ISDB2056NName% = WinUSBInstall, USB\VID_0511&PID_084B
%M1URName%      = WinUSBInstall, USB\VID_0511&PID_0854

[WinUSBInstall]
Include = winusb.inf
Needs   = WINUSB.NT
AddProperty = DeviceSetup.AddProperty

[WinUSBInstall.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[WinUSBInstall.HW]
AddReg = DeviceInterfaceGUID

[DeviceInterfaceGUID]
HKR,,DeviceInterfaceGUIDs,0x10000,"{2979184D-619D-480A-8F5D-13B5E89A67DF}"

[DeviceSetup.AddProperty]
; DEVPKEY_Device_SafeRemovalRequiredOverride = FALSE
{afd97640-86a3-4210-b67c-289c41aabe55},3,0x00000011,,0

[Strings]
ProviderName     = "coax"
ManufacturerName = "DigiBest"
ISDB2056Name     = "DigiBest ISDB2056 (WinUSB)"
ISDB2056NName    = "DigiBest ISDB2056N (WinUSB)"
M1URName         = "PLEX PX-M1UR (WinUSB)"
